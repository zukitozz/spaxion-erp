generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(uuid())
  name                   String
  email                  String                 @unique
  password               String
  role                   UserRole               @default(ADMIN)
  celular1               String?
  celular2               String?
  createdAt              DateTime               @default(now())
  cierresTurno           CierreTurno[]
  facturas               Factura[]
  tratamientosRealizados AtencionTratamiento[]  @relation("AtencionesEsteticista")
  cabinaEstadoLogs       CabinaEstadoLog[]
  movimientosInventario  MovimientoInventario[]
}

enum UserRole {
  SUPERVISOR
  ADMIN
  ESTETICISTA
}

model Cliente {
  id                         String     @id @default(uuid())
  nombre                     String
  dni                        String?    @unique
  ruc                        String?    @unique
  carnetExtranjeria          String?    @unique
  razonSocial                String?
  celular                    String?
  distrito                   String?
  email                      String?
  fechaNacimiento            DateTime?
  peso                       Float?
  edad                       Int?
  altura                     Float?
  notas                      String?
  recordatorioPospuestoHasta DateTime?
  citas                      Cita[]
  facturas                   Factura[]
  atenciones                 Atencion[]
  createdAt                  DateTime   @default(now())
}

model Cita {
  id            String     @id @default(uuid())
  cliente       Cliente?   @relation(fields: [clienteId], references: [id])
  clienteId     String?
  fecha         DateTime
  tratamiento   String
  duracionMin   Int?
  descripcion   String?
  estado        CitaEstado @default(PENDIENTE)
  registrado    Boolean    @default(false)
  origen        CitaOrigen @default(APP)
  googleEventId String?    @unique
  createdAt     DateTime   @default(now())
  atenciones    Atencion[]
}

enum CitaEstado {
  PENDIENTE
  CONFIRMADA
  ATENDIDA
  CANCELADA
  EXPIRADA
}

enum CitaOrigen {
  APP
  GOOGLE
}

model Cabina {
  id         String            @id @default(uuid())
  nombre     String
  estado     CabinaEstado      @default(DISPONIBLE)
  createdAt  DateTime          @default(now())
  atenciones Atencion[]
  estadoLogs CabinaEstadoLog[]
}

enum CabinaEstado {
  DISPONIBLE
  ATENCION
  LIMPIEZA
  MANTENIMIENTO
}

enum AtencionEstado {
  PENDIENTE
  EN_CURSO
  FINALIZADA
  CANCELADA
}

// Representa una visita/sesión del cliente. Ya no requiere cabina ni un único
// tratamiento: el detalle de cada tratamiento vive en AtencionTratamiento.
model Atencion {
  id         String    @id @default(uuid())
  cabina     Cabina?   @relation(fields: [cabinaId], references: [id])
  cabinaId   String?
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  clienteId  String
  cita       Cita?     @relation(fields: [citaId], references: [id])
  citaId     String?
  horaInicio DateTime  @default(now())
  horaFin    DateTime?
  notas      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  estadoLogs   CabinaEstadoLog[]
  fotos        AtencionFoto[]
  productos    AtencionProducto[]
  tratamientos AtencionTratamiento[]

  @@index([cabinaId])
  @@index([clienteId])
  @@index([citaId])
}

// Línea de tratamiento dentro de una Atencion (visita). Una visita puede tener
// varias, cada una con su propia esteticista, estado y horaInicio/horaFin
// para medir cuánto demora cada tratamiento.
model AtencionTratamiento {
  id                     String         @id @default(uuid())
  atencion               Atencion       @relation(fields: [atencionId], references: [id])
  atencionId             String
  tratamiento            Tratamiento    @relation(fields: [tratamientoId], references: [id])
  tratamientoId          String
  esteticista            User           @relation("AtencionesEsteticista", fields: [esteticistaId], references: [id])
  esteticistaId          String
  estado                 AtencionEstado @default(PENDIENTE)
  horaInicio             DateTime?
  horaFin                DateTime?
  notas                  String?
  diasProximoTratamiento Int?
  orden                  Int            @default(0)
  // Precio acordado al asignar el tratamiento a la visita (puede diferir del catálogo).
  // precioCatalogo guarda el precio del Tratamiento en ese momento, para poder comparar después.
  precio                 Float?
  precioCatalogo         Float?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  factura   Factura? @relation(fields: [facturaId], references: [id])
  facturaId String?

  @@index([atencionId])
  @@index([tratamientoId])
  @@index([esteticistaId])
  @@index([facturaId])
}

model AtencionProducto {
  id         String   @id @default(uuid())
  atencion   Atencion @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  atencionId String
  producto   Producto @relation(fields: [productoId], references: [id])
  productoId String
  cantidad   Int      @default(1)
  precioUnit Float
  // Precio del catálogo (Producto.precioVenta) en el momento en que se agregó, para poder
  // evidenciar si precioUnit fue modificado respecto al catálogo.
  precioCatalogo Float?
  creadoAt   DateTime @default(now())

  factura   Factura? @relation(fields: [facturaId], references: [id])
  facturaId String?

  @@index([atencionId])
  @@index([facturaId])
}

enum FotoTipo {
  ANTES
  DESPUES
  EVOLUCION
}

model AtencionFoto {
  id          String    @id @default(uuid())
  atencion    Atencion  @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  atencionId  String
  tipo        FotoTipo?
  key         String
  descripcion String?
  creadoAt    DateTime  @default(now())

  @@index([atencionId])
}

model CabinaEstadoLog {
  id             String       @id @default(uuid())
  cabina         Cabina       @relation(fields: [cabinaId], references: [id])
  cabinaId       String
  estadoAnterior CabinaEstado
  estadoNuevo    CabinaEstado
  usuario        User         @relation(fields: [usuarioId], references: [id])
  usuarioId      String
  atencion       Atencion?    @relation(fields: [atencionId], references: [id])
  atencionId     String?
  motivo         String?
  creadoAt       DateTime     @default(now())

  @@index([cabinaId, creadoAt])
}

model Producto {
  id            String                 @id @default(uuid())
  nombre        String
  descripcion   String?
  precioVenta   Float
  precioCosto   Float?
  stock         Int                    @default(0)
  alertaStock   Int                    @default(5)
  codigoBarras  String?                @unique
  imagenUrl     String?
  creadoAt      DateTime               @default(now())
  facturaItems  FacturaItem[]
  tratamientos  TratamientoProducto[]
  atencionItems AtencionProducto[]
  movimientos   MovimientoInventario[]
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
}

model MovimientoInventario {
  id            String         @id @default(uuid())
  producto      Producto       @relation(fields: [productoId], references: [id])
  productoId    String
  tipo          MovimientoTipo
  cantidad      Int
  stockAnterior Int
  stockNuevo    Int
  motivo        String?
  usuario       User           @relation(fields: [usuarioId], references: [id])
  usuarioId     String
  creadoAt      DateTime       @default(now())

  @@index([productoId, creadoAt])
}

model Tratamiento {
  id                     String                @id @default(uuid())
  nombre                 String
  descripcion            String?
  precio                 Float
  duracionMin            Int
  activo                 Boolean               @default(true)
  diasProximoTratamiento Int?
  creadoAt               DateTime              @default(now())
  insumos                TratamientoProducto[]
  atenciones             AtencionTratamiento[]
}

model TratamientoProducto {
  id            String      @id @default(uuid())
  tratamiento   Tratamiento @relation(fields: [tratamientoId], references: [id], onDelete: Cascade)
  tratamientoId String
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId    String
  cantidad      Float       @default(1)
  unidad        String      @default("unidad")

  @@unique([tratamientoId, productoId])
}

model Factura {
  id                   String                @id @default(uuid())
  cliente              Cliente               @relation(fields: [clienteId], references: [id])
  clienteId            String
  tipo                 FacturaTipo
  total                Float
  metodoPago           MetodoPago
  estado               String
  activo               Boolean               @default(true)
  creadoAt             DateTime              @default(now())
  items                FacturaItem[]
  atencionTratamientos AtencionTratamiento[]
  atencionProductos    AtencionProducto[]

  tipoComprobante             String?
  numeracionComprobante       String?
  fechaEmision                DateTime?
  tipoMoneda                  String?      @default("PEN")
  tipoOperacion               String?      @default("0101")
  tipoNota                    String?
  tipoDocumentoAfectado       String?
  fechaDocumentoAfectado      DateTime?
  numeracionDocumentoAfectado String?
  motivoDocumentoAfectado     String?
  totalVenta                  String?
  montoLetras                 String?
  cadenaParaCodigoQr          String?
  codigoHash                  String?
  pdfBytes                    String?
  url                         String?
  errors                      String?
  comentario                  String?
  pagoTarjeta                 Float?
  pagoEfectivo                Float?
  pagoYape                    Float?
  pagoTransferencia           Float?
  pagoDeposito                Float?
  billete                     Float?
  ruc                         String?
  enviado                     Boolean      @default(false)
  estadoNotaDespacho          Boolean      @default(false)
  comprobanteNotaDespacho     String?
  fechaFacturadoNotaDespacho  DateTime?
  usuario                     User?        @relation(fields: [usuarioId], references: [id])
  usuarioId                   String?
  cierreTurno                 CierreTurno? @relation(fields: [cierreTurnoId], references: [id], onDelete: SetNull)
  cierreTurnoId               String?
  fechaHora                   DateTime?
  gravadas                    Float?
  igv                         Float?
  xmlEnvio                    String?
  impresion                   Int          @default(1)
}

enum FacturaTipo {
  BOLETA
  FACTURA
  NOTA_VENTA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
  DEPOSITO
}

model FacturaItem {
  id             String    @id @default(uuid())
  factura        Factura   @relation(fields: [facturaId], references: [id])
  facturaId      String
  nombre         String
  cantidad       Int
  precioUnit     Float
  total          Float
  // Precio del catálogo (Tratamiento.precio / Producto.precioVenta) al momento de facturar.
  // Se compara contra precioUnit para evidenciar un cambio de precio base en los reportes.
  precioCatalogo Float?
  codigoProducto String?
  igv            Float?
  decCantidad    Float?
  decSubtotal    Float?
  decTotal       Float?
  valor          Float?
  precio         Float?
  igvVenta       Float?
  codigo         Int?
  producto       Producto? @relation(fields: [productoId], references: [id])
  productoId     String?
}

model CierreTurno {
  id                 String    @id @default(uuid())
  usuario            User      @relation(fields: [usuarioId], references: [id])
  usuarioId          String
  fechaInicio        DateTime
  fechaFin           DateTime
  totalVentas        Float
  totalEfectivo      Float
  totalTarjeta       Float
  totalYape          Float
  totalTransferencia Float     @default(0)
  totalDeposito      Float     @default(0)
  activo             Boolean   @default(true)
  creadoAt           DateTime  @default(now())
  facturas           Factura[]
}

model Configuracion {
  id                    String   @id @default("default")
  nombreEmpresa         String   @default("Spaxión Centro Estético")
  ruc                   String?  @db.VarChar(11)
  razonSocial           String?
  direccionFiscal       String?
  codigoUbigeo          String?
  googleCalendarActivo  Boolean  @default(false)
  googleCalendarId      String?
  googleRefreshTokenEnc String?
  googleCuentaEmail     String?
  googleSyncToken       String?
  facturacionEndpoint   String?
  facturacionActivo     Boolean  @default(false)
  horasExpiracionCita   Int      @default(24)
  usaCabinas            Boolean  @default(true)
  actualizadoAt         DateTime @updatedAt
}

model Serie {
  id              String  @id @default(uuid())
  codigoProposito String  @db.VarChar(50)
  tipoComprobante String  @db.VarChar(2)
  serie           String  @db.VarChar(3)
  estado          Int     @default(1)
  descripcion     String? @db.VarChar(200)
}

model Correlativo {
  id            String   @id @default(uuid())
  tipoDocumento String   @db.VarChar(2)
  serie         String   @db.VarChar(3)
  prefijo       String   @db.VarChar(2)
  numeracion    Int      @default(0)
  estado        String   @default("A") @db.Char(1)
  ruc           String   @db.VarChar(11)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ruc, tipoDocumento, serie, prefijo])
}
